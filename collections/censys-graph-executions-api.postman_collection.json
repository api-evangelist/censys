          "name": "Censys Create a Graph Execution",
          "request": {
            "name": "Censys Create a Graph Execution",
            "description": {
              "content": "Start a new on-demand execution for an asset graph. An execution triggers the discovery process using the graph's configured seeds and excluded assets. Creating an execution will preempt and cancel any currently running execution. Executions may take up to several hours to complete.\n\nCensys also periodically runs executions in the background. Older executions are removed automatically.",
              "type": "text/plain"
            },
